# Copy this file to .env.local and fill in your values.
#
# HOW TO GET THIS VALUE:
# 1. Go to vercel.com → your project → Storage tab
# 2. Click "Create Database" → choose Postgres (Neon)
# 3. After creation, click "Connect" → copy the connection string
# 4. Paste it below:

POSTGRES_URL="postgresql://user:password@host/dbname?sslmode=require"
